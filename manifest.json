{
  "manifest_version": 3,
  "name": "FB Marketplace 智能卖家助手",
  "version": "2.25.0",
  "description": "导入并批量续期你在 Facebook Marketplace 上已有的商品,自动填表发布,并用商品信息自动回复买家询问(可选 AI 智能回复)",
  "permissions": ["storage", "tabs", "alarms", "sidePanel"],
  "host_permissions": ["https://www.facebook.com/*", "https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FB Marketplace 智能卖家助手(点击打开侧边栏)"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/create/*"],
      "js": ["storage.js", "field-utils.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/marketplace/inbox/*",
        "https://www.facebook.com/messages/*"
      ],
      "js": ["storage.js", "content-inbox.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/marketplace/you/*"],
      "js": ["storage.js", "field-utils.js", "content-my-listings.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/marketplace/you/*"],
      "js": ["network-capture.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.facebook.com/marketplace/item/*"],
      "js": ["storage.js", "field-utils.js", "content-item.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/marketplace/item/*"],
      "js": ["network-capture.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
