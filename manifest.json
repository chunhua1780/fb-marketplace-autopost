{
  "manifest_version": 3,
  "name": "FB Marketplace 智能卖家助手",
  "version": "2.0.0",
  "description": "自动填表发布/续期 Facebook Marketplace 商品,并用商品信息自动回复买家询问(可选 AI 智能回复)",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://www.facebook.com/*", "https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB Marketplace 智能卖家助手"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/create/*"],
      "js": ["storage.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/marketplace/inbox/*",
        "https://www.facebook.com/messages/*"
      ],
      "js": ["storage.js", "content-inbox.js"],
      "run_at": "document_idle"
    }
  ]
}
